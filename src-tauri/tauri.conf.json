{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "波日程",
  "mainBinaryName": "BoSchedule",
  "version": "1.0.4",
  "identifier": "com.guyuebo.boschedule",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "简洁、灵活的多平台日程与课程表应用",
    "longDescription": "波日程是一款遵循瑞士网格设计语言的日程与课程表应用，支持多时间表、AI 导入、Excel/长图分享与局域网同步。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
